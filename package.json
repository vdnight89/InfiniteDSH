{
  "name": "dsh-infinite",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "诸天万界 for DeepSeek Harness: one session is one book",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "interactive-fiction",
    "text-adventure"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vdnight89/InfiniteDSH.git"
  },
  "homepage": "https://github.com/vdnight89/InfiniteDSH#readme",
  "bugs": {
    "url": "https://github.com/vdnight89/InfiniteDSH/issues"
  },
  "author": "InfiniteDSH contributors",
  "main": "./packages/dsh-infinite/dist/index.bundle.js",
  "types": "./packages/dsh-infinite/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/dsh-infinite/dist/index.d.ts",
      "import": "./packages/dsh-infinite/dist/index.bundle.js"
    },
    "./restrict": {
      "types": "./packages/dsh-infinite/dist/restrict.d.ts",
      "import": "./packages/dsh-infinite/dist/restrict.js"
    }
  },
  "files": [
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE.md",
    "packages/dsh-infinite/dist/index.bundle.js",
    "packages/dsh-infinite/dist/index.d.ts",
    "packages/dsh-infinite/static",
    "packages/dsh-infinite/cordis.patch.yml",
    "packages/dsh-infinite-preset/package.json",
    "packages/dsh-infinite-preset/templates",
    "packages/dsh-infinite-preset/covers",
    "packages/dsh-infinite-preset/infinite-play"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "npm run build -w infinite-core && npm run build -w @infinite-dsh/host && node scripts/bundle-host.mjs",
    "import:airp": "node scripts/import-airp-presets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "workspaces": [
    "packages/infinite-core",
    "packages/dsh-infinite",
    "packages/dsh-infinite-preset"
  ],
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
