{
  "name": "@infinite-dsh/host",
  "version": "0.4.6",
  "private": true,
  "type": "module",
  "description": "DSH host plugin sources (install the repo root package dsh-infinite)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./restrict": {
      "types": "./dist/restrict.d.ts",
      "import": "./dist/restrict.js"
    }
  },
  "files": [
    "dist",
    "static",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "infinite-core": "0.4.6",
    "dsh-infinite-preset": "0.4.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}
